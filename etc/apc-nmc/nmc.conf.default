# APC NMC emulation settings
[upsd]
host = 127.0.0.1
port = 3493
ups = myups
user = upsmon
password = CHANGEME

[device]
# values the UPS does not report over USB HID - edit to match reality
ups_name = APC Smart-UPS
va_rating = 1000
rated_output_voltage = 230
high_transfer_volt = 253
low_transfer_volt = 207
nominal_input_voltage = 230
nominal_frequency = 50
battery_replace_date = 01/10/16
# electricity cost for the Energy card (0 = hide cost estimate)
energy_rate = 0.30
energy_currency = €
nmc_name = apc-nmc
nmc_serial = 5A2436E12345
nmc_fw = v7.1.2
location = Server Room
contact = admin@localhost

[snmp]
# PowerNet-MIB trap destinations (OPP-005). One or more host[:port],
# comma-separated. Empty = no traps sent.
trapsink =
trapcommunity = public

[notify]
# Outbound event notifications (OPP-008). warn+crit events are forwarded.
# syslog: "local" = journald /dev/log; host[:port] = UDP syslog (default 514).
syslog = local
webhook =
min_sev = warn
# hook: optional script run on every UPS event; called as
#   hook <flag> <on|off> "<status-string>"  (empty = disabled)
hook =

# Optional extra web logins: name = [role:]password-or-hash (D4 multi-user).
# Roles: admin (full), device (UPS ops only), network (network config),
# readonly (view only). A bare password is a legacy full-access admin.
# [users]
# readonly = readonly:examplepass
# tech = device:techpass

[radius]
# Fallback auth for web logins (PAP, UDP/1812): tried only when no
# local account matches. RADIUS users get `role`.
enabled = 0
server =
port = 1812
secret =
timeout = 4
role = readonly

[modbus]
# Modbus TCP server (apc-nmc-modbus.service) — lets BMS clients poll the
# UPS register map in docs/modbus-registers.md. Enable/disable the
# service from Configuration > System; these keys tune it.
bind = 0.0.0.0
port = 502
unit = 1
# allow_write = 1 lets clients run UPS instant commands through the
# command register/coils — off by default (read-only telemetry).
allow_write = 0

[dot1x]
# Wired 802.1X (EAPoL) via wpa_supplicant - service toggled from the UI.
iface = eth0
eap = PEAP          # PEAP | TTLS | TLS | FAST
identity =
password =
phase2 = auth=MSCHAPV2
ca_cert =
client_cert =
private_key =
private_key_pass =

[firewall]
# nftables input filter (apc-nmc-firewall.service) - toggled from the UI.
# 22/80/443 + UDP 161/5353 are always allowed; extras below.
allow_tcp =
allow_udp =
# space-separated CIDRs allowed to reach any service; empty = any
allow_from =

[web]
# read-only bearer token for monitoring endpoints (Nagios, Prometheus
# scrapes of /metrics, /api/v1/vars, /api/v1/commands). Send as
# "Authorization: Bearer <token>". Empty = API auth disabled.
api_token =

[schedule]
# weekly self-test: weekday 0-6 (Mon-Sun) + hour 0-23; empty = disabled
selftest_weekday =
selftest_hour =

[update]
# Software updates for this card (About > System > Check for updates).
# The updater pulls from the repo install.sh was fetched from.
repo = ArMaTeC/apcupspi
branch = main
# channel = releases  -> update from the newest GitHub release/tag,
#                        falling back to the branch when none exist
# channel = branch    -> track branch head (VERSION file) directly
channel = releases
# verify = checksum -> verify the release's sha256 asset when present
# verify = strict   -> refuse to apply an update with no checksum
# verify = 0        -> never verify
verify = checksum
# daily background check via apc-nmc-update-check.timer; 0 disables it
# (manual checks and updates still work)
autocheck = 1
