[Unit]
Description=First boot configuration wizard
ConditionPathExists=!/etc/firstboot.done
DefaultDependencies=no
After=local-fs.target dbus.service systemd-logind.service NetworkManager.service
Before=getty@tty1.service ssh.service

[Service]
Type=oneshot
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStartPre=/usr/bin/ssh-keygen -A
ExecStart=/usr/local/sbin/firstboot-wizard.sh
ExecStartPost=/usr/bin/touch /etc/firstboot.done
ExecStartPost=/usr/bin/systemctl disable firstboot-wizard.service
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
