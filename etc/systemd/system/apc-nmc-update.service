[Unit]
Description=APC NMC software update (apply)
After=network-online.target
Wants=network-online.target

# Started on demand by the web UI (systemctl --no-block) or by hand.
# Applies the payload and restarts affected services, including the
# web interface, so it must be able to write /usr and /etc.
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/apc-nmc-update.sh --apply
TimeoutStartSec=300
